# AsterGraph 로컬 설정. 기존 DB를 지정하기 전에 경로를 확인하세요.
DEBUG=true
API_HOST=127.0.0.1
API_PORT=8001
LOG_LEVEL=INFO

# 기본 비활성 계약 유지. 사용 시 명시적으로 true.
KNOWLEDGE_ENABLED=false
KNOWLEDGE_DB_PATH=data/knowledge/knowledge.db
KNOWLEDGE_SEARCH_MODEL=
KNOWLEDGE_REVIEW_MODEL=qwen3.8:27b-q4_K_M
KNOWLEDGE_GENERATION_PROVIDER=ollama
KNOWLEDGE_GENERATION_CONTEXT_LENGTH=49152

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:31b-it-q4_K_M
OLLAMA_TIMEOUT=180
# 지식 구축 모델의 기존 환경변수 이름을 호환 유지합니다.
STRUCTURING_MODEL=gemma4:31b-it-q4_K_M
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
