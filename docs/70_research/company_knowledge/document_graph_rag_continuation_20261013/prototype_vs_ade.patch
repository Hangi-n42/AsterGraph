+def listwise_passages(service, run, candidates, ranked, blocks, options, limit):
+    """Select reader evidence from a bounded retrieved pool; never decide eligibility."""
+    pool = ranked[:5 * limit]
+    if not pool:
+        run['source_selection'] = dict(pool_ids=[], selections=[], status='no_retrieved_candidates')
+        return []
+    by_id = {c['id']: c for c in candidates}
+    context = [{k: v for k, v in by_id[h['block_id']].items() if k != 'linked_claim_ids'} for h in pool]
+    required = source_context(blocks, context, options)
+    aliases = {row['id']: f'k{i+1}' for i, row in enumerate(context)}
+    row_type = create_model('SourceSelection', candidate_id=(Literal[tuple(aliases)], Field(...)),
+        request_quotes=(list[str], Field(min_length=1)), relevance=(str, Field(min_length=1)))
+    schema = create_model('SourceSelections', selections=(list[row_type], Field(max_length=limit)))
+    references = dict(aliases)
+    addresses = required + [dict(id=c['source_reference']['block_id'], **{
+        k: c['source_reference'].get(k) for k in ('source_version_id', 'parse_run_id')}) for c in context]
+    for field, prefix in [('id', 'b'), ('source_version_id', 'v'), ('parse_run_id', 'p')]:
+        values = list(dict.fromkeys(row[field] for row in addresses if row.get(field)))
+        references.update({value: f'{prefix}{i+1}' for i, value in enumerate(values) if value not in references})
+    run['source_selection'] = dict(contract='whole-query-bounded-source-selection-v1',
+        pool_ids=list(aliases), pool_multiplier=5, selection_limit=limit, ranking_is_semantic_validation=False)
+    output = business_run.json_call(service, run, 'source_passage_selection',
+        '전체 원 질문의 공통 상황·앞절·지시대상과 각 요청에 답하는 데 필요한 제공 원문 구간 ID를 선택한다. '
+        '후보와 source_context의 표·상위 문맥·조건·예외를 함께 읽고 요청 포괄에 필요한 구간을 선택한다. '
+        '선택은 관련 근거의 전달이며 기업의 지원 가능성이나 법적 정답을 판정하지 않는다. '
+        'selections에는 candidate_id, 질문의 정확한 연속 구절 request_quotes, 짧은 관련성 relevance를 쓴다. '
+        '각 ID는 한 번만 선택하며 최대 selection_limit개다. 원문에 없는 답변·조건·정정문을 만들지 않는다. '
+        '같은 출처라도 조건·대상·시점이 다른 구간을 의미가 같다고 합치지 않는다.',
+        dict(question=run['query']['question'], choices=run['query']['choices'],
+             selection_limit=limit, candidates=context, source_context=required), schema,
+        reference_map=references)
+    if output is None:
+        reason = run['units'][-1].get('error') if run.get('units') else None
+        raise ValueError('source_selection_input_capacity' if reason == 'input_capacity' else 'source_selection_failed')
+    selected = output.get('selections', [])
+    ids = [row['candidate_id'] for row in selected]
+    if (len(ids) > limit or len(ids) != len(set(ids)) or not set(ids) <= set(aliases)
+            or any(not row['request_quotes'] or any(not text.strip() or text not in run['query']['question']
+                       for text in row['request_quotes']) for row in selected)):
+        raise ValueError('invalid_source_selection')
+    run['source_selection']['selections'] = selected
+    run['source_selection']['status'] = 'selected' if ids else 'valid_empty_selection'
+    run['source_selection']['reasons_are_answer_evidence'] = False
+    hits = {row['block_id']: row for row in pool}
+    return [hits[cid] for cid in ids]
+
+
+def native_source_bundle(context, required):
+    """Order unchanged records by parser location and keep exact reversible array maps."""
+    by_id = {row['id']: row for row in context}
+    entries = []
+    for origin, rows in enumerate((context, required)):
+        for position, row in enumerate(rows):
+            located = by_id.get(row.get('context_id'), row)
+            ref = located.get('source_reference', located)
+            locator = located.get('locator', {})
+            span = located.get('span', [ref.get('start_char', 0), ref.get('end_char', len(located.get('text', '')))])
+            if 'block_order' not in locator:
+                raise ValueError('native_source_position_missing')
+            key = (ref['source_version_id'], ref.get('parse_run_id') or '', locator['block_order'],
+                   *span, locator.get('element_path', ''), origin, position)
+            entries.append((key, origin, position, row))
+    entries.sort(key=lambda item: item[0])
+    bundle = dict(blocks=[entry[3] for entry in entries], context_rows=[], source_context_rows=[])
+    for origin, rows, field in [(0, context, 'context_rows'), (1, required, 'source_context_rows')]:
+        locations = {entry[2]: index for index, entry in enumerate(entries) if entry[1] == origin}
+        bundle[field] = [locations[i] for i in range(len(rows))]
+        if [bundle['blocks'][i] for i in bundle[field]] != rows:
+            raise ValueError('native_source_roundtrip_failed')
+    return bundle


